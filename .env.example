# Copy to .env (git-ignored) and replace every "changethis".
# Generate secrets with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Outside development, the backend refuses to start while a secret is "changethis".

# Development behaviour for commands that import the app directly.
# Never set this in a deployment.
FASTAPI_ENV=development

PROJECT_NAME=Sonovarem
SECRET_KEY=changethis

# Origin allowed by CORS (the Vite dev server)
FRONTEND_HOST=http://localhost:5173

# Postgres (pgvector), started with `docker compose up -d db redis`
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Optional
SENTRY_DSN=

# Compose deployments only (deployment-docker-compose.md)
# DOMAIN=localhost
